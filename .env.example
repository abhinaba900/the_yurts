# Sanity — from https://sanity.io/manage after creating a project.
# The site builds and runs without these; content sections simply stay empty.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-01-01

# Server-only. Needed for draft previews. Never prefix this with NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=

# Shared secret for the Sanity publish webhook -> /api/revalidate.
# Generate one with:  openssl rand -base64 32
# Must match the secret set on the webhook in sanity.io/manage.
SANITY_REVALIDATE_SECRET=

# Public site URL, used for canonicals, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://theyurts.in

# --- Enquiries -------------------------------------------------------------
# Until at least one of these is configured, the enquiry form REFUSES to report
# success and tells the visitor to get in touch another way. That is deliberate:
# a form that thanks someone while dropping their message is worse than no form.

# Sanity token with write access, so enquiries land in the Studio.
# Create at sanity.io/manage -> API -> Tokens, with Editor permission.
SANITY_API_WRITE_TOKEN=

# Resend, for the notification email. Optional if Sanity writes are configured.
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL=
# Comma-separated for more than one recipient.
ENQUIRY_TO_EMAIL=
